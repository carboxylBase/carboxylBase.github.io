{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":"<p>\u6765\u81ea\u897f\u5317\u5de5\u4e1a\u5927\u5b66\u7684\u7b97\u6cd5\u7ade\u8d5b\u7231\u597d\u8005.</p> <p>\u4e3b\u5305\u7684\u7b97\u6cd5\u7ade\u8d5b\u5e73\u53f0\u8d26\u53f7, \u5168\u5e73\u53f0\u540c\u540d(carboxylBase):</p> <p>codeforces</p> <p>\u6d1b\u8c37</p> <p>atcoder</p> <p>\u725b\u5ba2\u7ade\u8d5b</p> <p>\u4ee3\u7801\u6e90</p> <p>\u529b\u6263</p>"},{"location":"travelogue/","title":"\u65c5\u884c\u7684\u610f\u4e49","text":"<p>\u5982\u679c\u4ec0\u4e48\u90fd\u6ca1\u80fd\u7559\u4e0b\u7684\u8bdd, \u5c31\u592a\u53ef\u601c\u4e86.</p>"},{"location":"travelogue/#2024-icpc","title":"2024 ICPC \u5357\u4eac","text":""},{"location":"travelogue/#2024-icpc_1","title":"2024 ICPC \u676d\u5dde","text":""},{"location":"travelogue/#2024-ccsp","title":"2024 CCSP \u91d1\u534e","text":""},{"location":"travelogue/#2025-icpc","title":"2025 ICPC \u6b66\u6c49","text":""},{"location":"travelogue/#2025-icpc_1","title":"2025 ICPC \u6c88\u9633","text":""},{"location":"travelogue/#2025-ccpc","title":"2025 CCPC \u91cd\u5e86","text":""},{"location":"travelogue/#2025-ccac","title":"2025 CCAC \u9884\u8d5b","text":""},{"location":"travelogue/#2025","title":"2025 \u767e\u5ea6\u4e4b\u661f \u51b3\u8d5b","text":""},{"location":"travelogue/#2026-ec-final","title":"2026 EC-Final","text":""},{"location":"travelogue/2025icpc%E6%B2%88%E9%98%B3/","title":"2025 ICPC \u6c88\u9633","text":""},{"location":"travelogue/2025icpc%E6%B2%88%E9%98%B3/#day-1","title":"Day -1","text":"<p>\u4e34\u8d70\u524d\u6700\u540e vp \u4e00\u628a, 2025 CCPC \u54c8\u5c14\u6ee8, \u505a\u51fa\u4e86\u94f6\u724c\u7684\u53d8\u79cd manacher, \u4f46\u662f\u6ca1\u505a\u51fa\u94dc\u724c\u795e\u79d8\u6784\u9020, \u9057\u61be\u94dc\u9996\u4e86...</p>"},{"location":"travelogue/2025icpc%E6%B2%88%E9%98%B3/#day-0","title":"Day 0","text":"<p>\u961f\u53cb\u4e2d\u5348\u5750\u98de\u673a\u5148\u53bb\u6c88\u9633\u4e86, \u6211\u56e0\u4e3a\u4e0b\u5348\u6709\u5b9e\u9a8c\u8bfe\u6240\u4ee5\u8ba2\u4e86\u665a\u4e0a\u7684\u98de\u673a. \u5230\u4e86\u4e0b\u5348, \u7a81\u7136\u4e0d\u662f\u5f88\u60f3\u53bb\u4e0a\u8bfe, \u800c\u4e14\u884c\u674e\u4e5f\u6ca1\u6574\u7406\u597d...\u7b97\u4e86\u8fd8\u662f\u7fd8\u6389\u5427, \u53cd\u6b63\u6709\u5047\u6761.</p>"},{"location":"travelogue/2025icpc%E6%B2%88%E9%98%B3/#day-1_1","title":"Day 1","text":"<p>\u65e9\u4e0a\u7761\u5230 10 \u70b9\u624d\u8d77\u6765, \u6d17\u6f31\u4e00\u4e0b\u9a6c\u4e0a\u5c31\u53bb\u4e1c\u5317\u5927\u5b66\u7b7e\u5230\u4e86, \u5f88\u79bb\u5947\u7684\u662f\u6ca1\u6709\u62cd\u7167\u73af\u8282, \u5e76\u4e14\u53d1\u73b0\u4f53\u80b2\u573a\u91cc\u5728\u529e\u8fbd\u5b81\u7701\u8d5b, \u7701\u8d5b\u7adf\u7136\u80fd\u7528\u533a\u57df\u8d5b\u7684\u573a\u5730, \u592a\u8c6a\u534e. \u5348\u996d\u5728\u5b66\u6821\u98df\u5802\u89e3\u51b3\u4e86, \u5403\u5b8c\u4e4b\u540e\u7259\u6709\u70b9\u75bc, \u4e0d\u77e5\u9053\u662f\u4e0d\u662f\u9aa8\u5934\u6e23\u523a\u8fdb\u7259\u5e8a\u4e86?</p> <p>\u4e0b\u5348\u5728\u5b66\u6821\u901b\u4e86\u4f1a, \u7136\u540e\u53bb\u542c\u534e\u4e3a\u7684\u8bb2\u5ea7, \u8bf4\u5b9e\u8bdd\u542c\u4e0d\u592a\u61c2, \u5b8c\u4e8b\u4e4b\u540e\u53bb\u5403\u8457\u540d\u7684\u4e1c\u5317\u94c1\u9505\u7096, \u5473\u9053\u786e\u5b9e\u8fd8\u4e0d\u9519! \u4e1c\u5317\u5929\u9ed1\u5f97\u597d\u65e9\u554a, \u4e94\u70b9\u5c31\u9ed1\u900f\u4e86.</p> <p>\u5403\u5b8c\u996d\u8d76\u7d27\u8dd1\u53bb\u53c2\u52a0\u70ed\u8eab\u8d5b, \u8fdf\u5230\u4e86\u534a\u4e2a\u5c0f\u65f6, \u7136\u540e\u88ab A \u9898\u7684\u6784\u9020\u901a\u4fe1\u9898\u5355\u9632\u4e00\u4e2a\u534a\u5c0f\u65f6, \u961f\u53cb\u573a\u5207\u4e86\u4e09\u4e2a\u9898, \u5e76\u4e14\u8d5b\u540e\u79d2\u6740\u4e86 A , emmm , \u8bf4\u5b9e\u8bdd\u8fd9\u4e2a A \u786e\u5b9e\u4e0d\u96be, \u4f46\u6211\u4e0d\u77e5\u9053\u4e3a\u4ec0\u4e48\u6211\u6ca1\u60f3\u5230.</p> <p>\u72b6\u6001\u6709\u70b9\u5dee, \u5e0c\u671b\u660e\u5929\u4e0d\u8981\u72af\u75c5.</p>"},{"location":"travelogue/2025icpc%E6%B2%88%E9%98%B3/#day-2","title":"Day 2","text":"<p>\u8d70\u5230\u5b66\u6821\u95e8\u53e3\u65f6\u5929\u4e0a\u4e0b\u8d77\u4e86\u5c0f\u96ea.</p> <p>\u5192\u7740\u5bd2\u98ce\u62b5\u8fbe\u8d5b\u573a, \u611f\u89c9\u5fc3\u8df3\u5f97\u5f88\u5feb, \u7a00\u91cc\u7cca\u6d82\u7684\u542c\u5b8c\u4e86\u5f00\u5e55\u5f0f.</p> <p>\u6bd4\u8d5b\u5f00\u59cb, \u5f88\u5feb\u53d1\u73b0 I \u662f\u4e00\u4e2a\u975e\u5e38\u7b7e\u5230\u7684\u6a21\u62df\u9898, \u4e00\u53d1 AC. \u7136\u540e\u548c\u961f\u53cb\u4e00\u8d77\u770b B , \u6211\u770b\u4e86\u4e00\u773c\u6ca1\u4ec0\u4e48\u601d\u8def, \u5c31\u53bb\u770b M \u4e86, \u53d1\u73b0 M \u662f\u5927\u6a21\u62df, \u7acb\u9a6c\u4e0a\u673a\u5f00\u59cb\u5199, \u5199\u4e86\u81f3\u5c11 20 \u5206\u949f, \u7136\u540e\u53d1\u73b0\u8fc7\u4e0d\u4e86\u6837\u4f8b, \u8fd9\u65f6\u5df2\u7ecf\u6709\u70b9\u7ea2\u6e29\u4e86, \u597d\u5728\u4e00\u4e2a\u5c0f\u65f6\u7684\u65f6\u5019\u961f\u53cb\u987a\u5229\u8fc7\u4e86 B , \u611f\u89c9\u538b\u529b\u5c0f\u4e86\u4e9b, \u5f88\u5feb\u961f\u53cb\u53d1\u73b0\u6211\u662f\u628a M \u8f93\u5165\u5199\u9519\u4e86, \u6211\u7684\u5929\u5450\u6211\u600e\u4e48\u4f1a\u72af\u8fd9\u4e48\u4f4e\u7ea7\u7684\u9519\u8bef...\u57cb\u4e0b\u4f0f\u7b14\u4e86. \u6700\u7ec8\u4e00\u4e2a\u534a\u5c0f\u65f6\u624d\u8fc7 M .</p> <p>\u6b64\u65f6\u5df2\u7ecf\u6ca1\u4ec0\u4e48\u80fd\u5f00\u7684\u9898\u4e86, \u53ea\u6709 K \u8fc7\u5f97\u6bd4\u8f83\u591a, \u4f46\u662f\u6211\u4eec\u4e09\u4e2a\u90fd\u6ca1\u4ec0\u4e48\u601d\u8def, \u601d\u8003\u4e86\u4e00\u6bb5\u65f6\u95f4\u540e, \u6211\u51b3\u5b9a\u4e0d\u518d\u6d6a\u8d39\u65f6\u95f4, \u53bb\u5f00\u5176\u4ed6\u9898. G \u662f\u8ba1\u7b97\u51e0\u4f55\u554a, \u800c\u4e14\u548c\u79ef\u5206\u6709\u5173, \u770b\u4e0a\u53bb\u5f88\u5413\u4eba, but \u6211\u662f\u9ad8\u6570\u5927\u5e08, \u4e0d\u4f1a\u88ab\u4e8c\u91cd\u79ef\u5206\u5413\u8dd1. \u770b\u4e86\u4e00\u4f1a\u4e4b\u540e\u611f\u89c9\u8fd9\u9898\u5f88\u7269\u7406, \u5bf9\u79f0\u7684\u770b, \u7b54\u6848\u663e\u7136\u662f\u4e00\u4e2a\u5206\u5f0f, \u5206\u5b50\u5e94\u5f53\u662f $S_P * S_Q$, \u5206\u6bcd\u663e\u7136\u662f P \u4e0a\u67d0\u70b9\u7ed5 Q \u5f62\u6210\u7684\u8f68\u8ff9\u7684\u9762\u79ef, \u53ea\u7528\u518d\u505a\u4e00\u6b21\u51f8\u5305\u5c31\u53ef\u4ee5\u4e86. \u8fd9\u4e48\u7b80\u5355\u7684\u9898\u4e3a\u4ec0\u4e48\u53ea\u6709\u4e24\u4e2a\u4eba\u8fc7\u5462?? \u6211\u76f4\u63a5\u4e0a\u673a\u5f00\u59cb\u5199, \u6572\u4e86\u4e8c\u5341\u591a\u5206\u949f\u624d\u6572\u5b8c\u51f8\u5305\u6a21\u7248, \u6700\u7ec8\u5728 3 \u5c0f\u65f6\u65f6\u901a\u8fc7\u4e86 G , \u6211\u4eec\u6392\u540d\u4e0a\u5347\u5230 80 , \u5df2\u7ecf\u770b\u89c1\u80dc\u5229\u7684\u66d9\u5149\u4e86. </p> <p>\u6211\u53bb\u4e0a\u4e86\u4e2a\u5395\u6240, \u770b\u89c1\u5916\u9762\u96ea\u4e0b\u5f97\u5f88\u5927.</p> <p>\u534a\u5c0f\u65f6\u4e4b\u540e\u961f\u53cb\u89c2\u5bdf\u51fa\u4e86 K \u7684\u505a\u6cd5, \u6211\u89c9\u5f97\u5f88\u5bf9, \u4e0a\u673a\u6572\u5b8c, \u4e00\u53d1 AC, \u6392\u540d\u4e0a\u5347\u5230 26, \u91d1\u724c\u5e76\u975e\u9065\u4e0d\u53ef\u53ca.</p> <p>\u6700\u540e\u534a\u5c0f\u65f6\u51b3\u5b9a all in F, \u6211\u4e0a\u673a\u5199\u51fa\u6765\u4e00\u4e2a\u5c4e\u5c71\u4ee3\u7801, \u6700\u540e\u4e8c\u5341\u5206\u949f\u4e00\u76f4\u5728\u627e hack \u8c03\u4ee3\u7801, \u6700\u7ec8\u4e5f\u6ca1\u505a\u51fa\u6765, \u53ef\u60dc\u4e86, \u8fd8\u662f\u6ca1\u80fd\u6446\u8131\u5c01\u699c\u4ee5\u540e\u65e0\u6cd5\u8fc7\u9898\u7684\u8bc5\u5492.</p> <p>\u6700\u7ec8 rank 43 \u9057\u61be\u94f6\u724c\u7b2c\u4e09, \u6bd4\u91d1\u5c3e\u5dee\u4e86\u4e8c\u5341\u5206\u949f\u7f5a\u65f6, \u4e0d\u8fc7\u4e5f\u5f88\u4e0d\u9519\u4e86, \u8fd9\u4e2a\u53d1\u6325\u5df2\u7ecf\u8d85\u51fa\u9884\u671f. \u867d\u7136\u6ca1\u80fd\u593a\u91d1, \u4f46\u662f\u597d\u50cf\u80fd\u53bb ec-final \u4e86?</p> <p>\u8d70\u51fa\u8d5b\u573a, \u53d1\u73b0\u5916\u9762\u662f\u5929\u5df2\u7ecf\u6674\u4e86, \u4f46\u662f\u72c2\u98ce\u4f9d\u65e7, \u628a\u6211\u4eec\u961f\u540d\u724c\u4e0a\u7684\u6c14\u7403\u8fde\u6839\u62d4\u8d77...</p>"},{"location":"travelogue/2025icpc%E6%B2%88%E9%98%B3/#after-story","title":"After Story","text":"<p>\u540e\u6765\u53d1\u73b0, F \u6ca1\u505a\u51fa\u6765\u4e0d\u662f\u56e0\u4e3a\u6211\u4ee3\u7801\u5199\u6302\u4e86, \u800c\u662f\u56e0\u4e3a\u6709\u4e00\u4e2a\u7279\u6b8a\u60c5\u51b5\u6ca1\u8003\u8651\u5230, \u800c\u4e14\u8fd9\u4e2a\u60c5\u51b5\u4e0d\u7528 bfs \u627e\u73af\u6781\u96be\u5904\u7406.</p> <p>\u7136\u540e, A \u5176\u5b9e\u662f\u66f4\u53ef\u505a\u7684\u9898, \u8d5b\u65f6\u57fa\u672c\u6ca1\u5728\u8fd9\u4e2a\u9898\u4e0a\u82b1\u592a\u591a\u65f6\u95f4, \u76f4\u63a5\u8df3\u8fc7\u4e86. \u4e3a\u4ec0\u4e48\u4e0d\u80fd\u66f4\u4fe1\u4efb\u4e00\u70b9\u81ea\u5df1\u7684\u6570\u5b66\u80fd\u529b\u5462.</p> <p>\u8fd9\u573a\u6bd4\u8d5b\u5931\u8bef\u8fd8\u662f\u5f88\u591a\u7684, \u4e0d\u8fc7\u4e00\u5207\u5931\u8bef\u7684\u6839\u6e90\u90fd\u662f\u83dc, \u65e0\u987b\u591a\u8a00, \u7ee7\u7eed\u52a0\u7ec3, \u660e\u5e74, \u4e00\u5b9a\u4f1a\u8d62\u7684.</p>"}]}