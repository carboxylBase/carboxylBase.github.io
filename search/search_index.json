{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u793e\u4ea4\u8d26\u53f7","text":"<p>\u6765\u81ea\u897f\u5317\u5de5\u4e1a\u5927\u5b66\u7684\u7b97\u6cd5\u7ade\u8d5b\u7231\u597d\u8005.</p> <p></p> <p>\u4e3b\u5305\u7684\u7b97\u6cd5\u7ade\u8d5b\u5e73\u53f0\u8d26\u53f7:</p> <p>codeforces</p> <p>\u6d1b\u8c37</p> <p>atcoder</p> <p>\u725b\u5ba2\u7ade\u8d5b</p> <p>\u4ee3\u7801\u6e90</p> <p>\u529b\u6263</p>"},{"location":"dp/min_plus%E5%8D%B7%E7%A7%AF/","title":"min-plus\u5377\u79ef","text":"<p>\u7ed9\u5b9a\u4e24\u4e2a\u5e8f\u5217 \\(a = (a_0, a_1, \\dots, a_{n-1})\\) \u548c \\(b = (b_0, b_1, \\dots, b_{m-1})\\)\uff0c\u5b83\u4eec\u7684 min-plus \u5377\u79ef \u5b9a\u4e49\u4e3a\u5e8f\u5217 \\(c = (c_0, c_1, \\dots, c_{n+m-2})\\)\uff1a</p> \\[ c_k = \\min_{i+j=k} (a_i + b_j), \\quad k = 0, 1, \\dots, n+m-2 \\] <p>\u5373\u5bf9\u6bcf\u4e2a\u4e0b\u6807 \\(k\\)\uff0c\u53d6\u6240\u6709\u6ee1\u8db3 \\(i+j=k\\) \u7684\u7ec4\u5408 \\(a_i + b_j\\) \u4e2d\u7684\u6700\u5c0f\u503c\u3002</p>"},{"location":"dp/min_plus%E5%8D%B7%E7%A7%AF/#a-b","title":"\u5f53 a \u548c b \u90fd\u662f\u51f8\u5e8f\u5217\u65f6","text":"<p>\u8003\u8651\u5404\u81ea\u7684\u5dee\u5206\u6570\u7ec4 \\( \\Delta a \\) \u548c \\( \\Delta b \\)\uff0c\u5b83\u4eec\u90fd\u662f\u5355\u8c03\u9012\u589e\u7684\u3002\u4e3a\u4e86\u4f7f \\(c_i\\) \u53d6\u5f97\u6700\u5c0f\u503c\uff0c\u663e\u7136\u9700\u8981\u9009\u62e9 \\( \\Delta a\\) \u548c \\( \\Delta b\\) \u4e2d\u524d \\(i\\) \u5c0f\u7684\u5143\u7d20\u3002\u56e0\u6b64\uff0c\u6211\u4eec\u53ef\u4ee5\u987a\u4fbf\u5f97\u51fa\u7ed3\u8bba\uff1a\u5e8f\u5217 \\(c\\) \u4e5f\u662f\u51f8\u5e8f\u5217\u3002</p> <p>\u800c\u4e14\u4e0d\u96be\u53d1\u73b0\u8fd9\u4e2a\u8fc7\u7a0b\u53ef\u4ee5\u7528\u53cc\u6307\u9488\u7ebf\u6027\u7684\u5b8c\u6210\u3002</p>"},{"location":"ds/%E5%8F%AF%E6%8C%81%E4%B9%85%E5%8C%96%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/","title":"\u53ef\u6301\u4e45\u5316\u6570\u636e\u7ed3\u6784","text":""},{"location":"ds/%E5%8F%AF%E6%8C%81%E4%B9%85%E5%8C%96%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#_1","title":"\u53ef\u6301\u4e45\u5316\u7ebf\u6bb5\u6811","text":"<p>\u53ef\u6301\u4e45\u5316\u7ebf\u6bb5\u6811\u4e5f\u53eb\u4e3b\u5e2d\u6811, \u662f\u4e00\u79cd\u652f\u6301\u5386\u53f2\u7248\u672c\u67e5\u8be2\u548c\u5355\u70b9\u4fee\u6539\u7684\u7ebf\u6bb5\u6811, \u662f\u5efa\u7acb\u5728\u52a8\u6001\u5f00\u70b9\u7ebf\u6bb5\u6811\u7684\u57fa\u7840\u4e0a\u7684.</p> <p>\u8003\u8651\u7ebf\u6bb5\u6811\u5355\u70b9\u4fee\u6539\u7684\u8fc7\u7a0b, \u5b9e\u9645\u4e0a\u5c31\u662f\u4fee\u6539\u4e86\u4e00\u6761\u94fe, \u4e00\u4e2a\u8282\u70b9\u6709\u4e24\u4e2a\u513f\u5b50, \u5bf9\u4e8e\u88ab\u4f4d\u4e8e\u88ab\u4fee\u6539\u7684\u94fe\u4e0a\u7684\u513f\u5b50, \u6211\u4eec\u5355\u72ec\u5f00\u4e00\u4e2a\u65b0\u8282\u70b9, \u81f3\u4e8e\u53e6\u4e00\u4e2a\u513f\u5b50, \u6211\u4eec\u76f4\u63a5\u6307\u5411\u5b83\u539f\u672c\u7684\u6307\u9488\u5373\u53ef, \u56e0\u4e3a\u5b83\u7684\u4fe1\u606f\u662f\u4e0d\u53d8\u7684.</p> <p>\u4e8e\u662f, \u6211\u4eec\u5c31\u6709 \\(O(logn)\\) \u7684\u5355\u70b9\u4fee\u6539.</p>"},{"location":"ds/%E5%8F%AF%E6%8C%81%E4%B9%85%E5%8C%96%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#_2","title":"\u53ef\u6301\u4e45\u5316\u5b57\u5178\u6811","text":"<p>\u53ef\u6301\u4e45\u5316\u5b57\u5178\u6811\u7684\u601d\u60f3\u7c7b\u4f3c\u4e8e\u53ef\u6301\u4e45\u5316\u7ebf\u6bb5\u6811, \u8003\u8651\u63d2\u5165\u5b57\u7b26\u4e32\u7684\u8fc7\u7a0b, \u540c\u6837\u662f\u53ea\u4f1a\u4fee\u6539\u4e00\u6761\u94fe\u7684\u4fe1\u606f, \u53e6\u4e00\u6761\u94fe\u7684\u4fe1\u606f\u53ef\u4ee5\u590d\u5236.</p>"},{"location":"ds/%E5%8F%AF%E6%8C%81%E4%B9%85%E5%8C%96%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#_3","title":"\u533a\u95f4\u7248\u672c\u67e5\u8be2","text":"<p>\u6709\u65f6\u53ef\u80fd\u9700\u8981\u67e5\u8be2\u7b2c \\(l\\) \u5230 \\(r\\) \u4e2a\u64cd\u4f5c\u4ea7\u751f\u7684\u5f71\u54cd, \u6b64\u65f6\u6211\u4eec\u53ea\u9700\u67e5\u8be2\u7b2c \\(l - 1\\) \u4e2a\u7248\u672c\u548c\u7b2c \\(r\\) \u4e2a\u7248\u672c\u7684\u5dee\u5206\u5373\u53ef.</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/","title":"\u725b\u5ba2\u7ec3\u4e60\u8d5b 146","text":"<p>\u4e3b\u5305\u8fd9\u6b21\u8d85\u5e38\u53d1\u6325 rk8, \u53ef\u559c\u53ef\u8d3a, \u79bb\u6a59\u540d\u53c8\u8fdb\u4e00\u6b65!</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/#a","title":"A","text":"<p>\u4e0d\u59a8\u5c06\u6240\u6709\u786c\u5e01\u5806\u53d6\u5f97\u53ea\u5269\u4e0b\u4e00\u679a\u786c\u5e01, \u7136\u540e\u8003\u8651\u80fd\u4e0d\u80fd\u628a\u6240\u6709\u90fd\u5206\u914d\u6210\u5076\u6570.</p> <p>\u63d0\u4ea4\u8bb0\u5f55</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/#b","title":"B","text":"<p>\u53ef\u4ee5\u901a\u8fc7\u4e8c\u5206\u786e\u5b9a\u6bcf\u4e00\u5929\u80fd\u591f\u6536\u96c6\u54ea\u4e2a\u533a\u95f4\u7684\u5b66\u5206, \u5bf9\u4e8e\u8fd9\u4e2a\u533a\u95f4, \u53ef\u4ee5\u7528\u524d\u7f00\u548c\u7ef4\u62a4\u6700\u5927\u503c\u548c\u6b21\u5927\u503c.</p> <p>\u63d0\u4ea4\u8bb0\u5f55</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/#c","title":"C","text":"<p>\u67d0\u4e9b\u65f6\u523b\u5c0f\u7070\u7070\u7684\u4f4d\u7f6e\u662f\u786e\u5b9a\u7684, \u5217\u4e3e\u51fa\u6240\u6709\u5df2\u7ecf\u786e\u5b9a\u7684\u4f4d\u7f6e, \u8003\u8651\u8fd9\u4e9b\u4f4d\u7f6e\u7684\u8ddd\u79bb\u5947\u5076\u6027\u4ee5\u53ca\u662f\u5426\u5728\u540c\u4e00\u4fa7, \u53ef\u4ee5\u53d1\u73b0\u4e24\u8005\u4e4b\u95f4\u4e3a\u6b62\u90e8\u5206\u7684\u8df3\u8dc3\u6b21\u6570\u662f 0, 2, 4... \u6216\u8005 1,3,5... \u5373\u4e00\u6bb5\u5947\u6570\u6216\u8005\u4e00\u6bb5\u5076\u6570.</p> <p>\u503c\u5f97\u6ce8\u610f\u7684\u662f, \u6700\u540e\u4e00\u4e2a\u533a\u95f4\u7684\u8d21\u732e\u662f\u8fde\u7eed\u6574\u6570.</p> <p>\u8003\u8651\u5230\u8d21\u732e\u4e3a\u5947\u6570\u7684\u533a\u95f4\u81f3\u5c11\u6709 1 \u7684\u8d21\u732e, \u4e14\u53ea\u4f1a\u6539\u53d8\u4e00\u6b21\u603b\u8d21\u732e\u7684\u5947\u5076\u6027, \u6211\u4eec\u53ef\u4ee5\u901a\u8fc7\u5947\u5076\u6027\u5224\u65ad\u6709\u6ca1\u6709\u89e3. \u6b64\u5916, \u8fd8\u9700\u5224\u65ad\u6700\u5927\u53ef\u80fd\u8df3\u8dc3\u6b21\u6570\u662f\u5426\u5927\u4e8e\u7b49\u4e8e\u76ee\u6807\u6b21\u6570.</p> <p>\u63d0\u4ea4\u8bb0\u5f55</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/#d","title":"D","text":"<p>\u6bd4\u8f83\u7ecf\u5178\u7684\u4e24\u4e2a\u5173\u952e\u5b57\u7684\u6700\u77ed\u8def\u95ee\u9898.</p> <p>\u9898\u76ee\u8981\u6c42\u6211\u4eec\u6700\u5c0f\u5316\u64cd\u4f5c\u4e09\u7684\u6b21\u6570, \u4e0d\u59a8\u4ee5\u64cd\u4f5c\u4e09\u7684\u6b21\u6570\u4e3a\u7b2c\u4e00\u5173\u952e\u5b57, \u90a3\u4e48, \u5982\u679c\u6307\u4ee4\u96c6 \\(s\\) \u4e2d\u6ca1\u6709\u67d0\u4e2a\u65b9\u5411, \u6211\u4eec\u5c31\u628a\u5176\u4ee3\u4ef7\u5b9a\u4e49\u4e3a 1, \u5426\u5219\u4e3a 0.</p> <p>\u4ee5\u65f6\u95f4\u4e3a\u7b2c\u4e8c\u5173\u952e\u5b57, \u663e\u7136\u7b2c\u4e00\u5173\u952e\u5b57\u76f8\u540c\u7684\u60c5\u51b5\u4e0b, \u65f6\u95f4\u8d8a\u5c0f\u8d8a\u4f18. \u800c\u4e14, \u5982\u679c\u77e5\u9053\u5f53\u524d\u65f6\u95f4, \u6211\u4eec\u5c31\u53ef\u4ee5\u8ba1\u7b97\u51fa\u4e0b\u4e00\u4e2a\u9700\u8981\u7684\u5b57\u7b26\u518d\u6b21\u51fa\u73b0\u7684\u65f6\u95f4, \u8fd9\u4e1c\u897f\u663e\u7136\u53ef\u4ee5\u7ebf\u6027\u9884\u5904\u7406.</p> <p>\u63d0\u4ea4\u8bb0\u5f55</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/#e","title":"E","text":"<p>\u5f88\u6709\u610f\u601d\u7684\u9898.</p> <p>\u663e\u7136\u6211\u4eec\u53ef\u4ee5\u4e8c\u5206\u627e\u51fa\u67d0\u6b21\u64cd\u4f5c\u4e4b\u540e\u533a\u95f4\u4e2d\u7684\u6700\u5c0f\u503c, \u8fd9\u6837\u590d\u6742\u5ea6\u662f\u5e26 \\(\\log\\) \u7684, \u65e0\u6cd5\u901a\u8fc7, \u4f46\u8fd9\u542f\u793a\u6211\u4eec\u5bfb\u627e\u7ebf\u6027\u7684\u505a\u6cd5.</p> <p>\u8003\u8651\u4e8c\u5206\u7684\u8fc7\u7a0b, \u5982\u679c\u67d0\u6b21\u4e8c\u5206\u540e, \u6307\u9488\u5411\u5927\u7684\u65b9\u5411\u79fb\u52a8, \u90a3\u4e48\u4e0b\u6b21 check \u65f6\u6211\u4eec\u4e0d\u9700\u8981\u518d\u91cd\u65b0\u8ba1\u7b97\u5de6\u4fa7\u533a\u95f4\u7684\u8d21\u732e, \u56e0\u4e3a\u53ef\u4ee5\u76f4\u63a5\u7528\u8fd9\u6b21 check \u8ba1\u7b97\u51fa\u7684\u7ed3\u679c. \u6307\u9488\u5411\u5c0f\u7684\u65b9\u5411\u79fb\u52a8\u662f\u540c\u7406, \u66f4\u5927\u7684\u6570\u5b57\u4e0d\u9700\u8981\u518d\u8003\u8651\u4e86. \u4e8e\u662f, \u6211\u4eec\u53ef\u4ee5\u6bcf\u6b21\u90fd\u53d6\u5f53\u524d\u4fdd\u7559\u7684\u533a\u95f4\u7684\u4e2d\u4f4d\u6570, \u7136\u540e\u5c06\u533a\u95f4\u5927\u5c0f\u4e0d\u65ad\u6298\u534a, \u6700\u7ec8, \u65f6\u95f4\u590d\u6742\u5ea6\u662f\u7ebf\u6027\u7684.</p> <p>\u53ef\u4ee5\u7528 <code>nth_element</code> \u5b9e\u73b0, \u6ce8\u610f\u614e\u7528 vector, \u5c3d\u91cf\u624b\u5199\u6808, \u672c\u9898\u5361\u5e38.</p> <p>\u63d0\u4ea4\u8bb0\u5f55</p>"},{"location":"editorial/nowcoder/practice/%E7%89%9B%E5%AE%A2%E7%BB%83%E4%B9%A0%E8%B5%9B146/#f","title":"F","text":"<p>\u672c\u9898\u6709\u539f.</p> <p>\u81ea\u7136\u7684\u60f3\u6cd5\u662f, \u679a\u4e3e\u4e0a\u4e0b\u8fb9\u754c, \u7136\u540e\u5bf9\u4e8e\u6bcf\u4e00\u4e2a\u53f3\u8fb9\u754c, \u8003\u8651\u5176\u80fd\u5ef6\u4f38\u5230\u7684\u6700\u5de6\u5de6\u8fb9\u754c. \u5982\u679c\u94a6\u5b9a\u4e0b\u8fb9\u754c, \u5c06\u4e0a\u8fb9\u754c\u4e0d\u65ad\u4e0a\u79fb, \u4f1a\u53d1\u73b0\u5bf9\u4e8e\u6bcf\u4e00\u4e2a\u53f3\u8fb9\u754c\u6765\u8bf4, \u53ea\u6709\u65b0\u589e\u7684\u4e00\u884c\u53ef\u4ee5\u5f71\u54cd\u5176\u6700\u5de6\u5de6\u8fb9\u754c, \u4e8e\u662f, \u6211\u4eec\u53ef\u4ee5\u7ebf\u6027\u7684\u8003\u8651\u8fd9\u4e00\u884c\u7684\u5f71\u54cd, \u8fd9\u6837\u603b\u7684\u590d\u6742\u5ea6\u5c31\u662f \\(O(n^2 \\cdot m)\\) \u7684.</p> <p>\u63d0\u4ea4\u8bb0\u5f55</p> <p>\u76ee\u524d\u662f\u7ad9\u5185\u6700\u4f18\u89e3.</p>"},{"location":"graph/%E6%9C%80%E5%B0%8F%E7%8E%AF/","title":"\u6700\u5c0f\u73af","text":""},{"location":"graph/%E6%9C%80%E5%B0%8F%E7%8E%AF/#bfs","title":"bfs \u627e\u7b80\u5355\u73af","text":"<p>\u4e3b\u5305\u5728 2025ICPC\u6c88\u9633 \u4e2d\u88ab F \u4fd8\u864f, \u539f\u56e0\u5c31\u662f\u6ca1\u60f3\u5230 bfs \u627e\u7b80\u5355\u73af.</p> <p>\u4efb\u610f\u9009\u4e00\u4e2a\u70b9\u5f00\u59cb bfs, \u8003\u8651 bfs \u751f\u6210\u6811, \u7b2c\u4e00\u6b21\u8bbf\u95ee\u5230\u8bbf\u95ee\u8fc7\u7684\u70b9\u65f6, \u5f62\u6210\u7684\u5fc5\u7136\u662f\u7b80\u5355\u73af, \u800c\u4e14\u8fd9\u4e2a\u7b80\u5355\u73af\u5177\u6709\u4e00\u4e9b\u7279\u522b\u7684\u6027\u8d28, \u6bd4\u5982\u8bf4\u8fd9\u662f\u79bb\u8d77\u70b9\u6700\u8fd1\u7684\u73af, \u522b\u7b11, \u8fd9\u5728\u67d0\u4e9b\u9898\u91cc\u771f\u7684\u975e\u5e38\u6709\u7528!!!</p>"},{"location":"graph/%E6%9C%80%E5%B0%8F%E7%8E%AF/#dijkstra","title":"dijkstra \u627e\u6700\u5c0f\u73af","text":"<p>\u8fd9\u4e2a\u6280\u5de7\u76f8\u5bf9\u51b7\u95e8\uff0c\u4f46 \\(O(n m \\log n)\\) \u7684\u65b9\u6cd5\u8f83\u4e3a\u76f4\u89c2\uff1a\u53ef\u4ee5\u679a\u4e3e\u56fe\u4e2d\u7684\u6bcf\u4e00\u6761\u8fb9\uff0c\u8bbe\u7aef\u70b9\u4e3a \\(u\\) \u548c \\(v\\)\uff0c\u4ee5 \\(u\\) \u4e3a\u8d77\u70b9\u8fd0\u884c Dijkstra \u7b97\u6cd5\uff0c\u5229\u7528\u5f97\u5230\u7684\u6700\u77ed\u8ddd\u79bb <code>dist[v]</code> \u66f4\u65b0\u7b54\u6848\uff1a</p> \\[ \\text{ans} = \\min(\\text{ans}, \\text{dist}[v] + w(u, v)) \\] <p>\u5176\u4e2d \\(w(u, v)\\) \u4e3a\u8fb9 \\((u, v)\\) \u7684\u6743\u91cd\u3002</p>"},{"location":"library/","title":"cpp\u6a21\u7248","text":"<pre><code>#define DEBUG 1\n#define FUCK cout &lt;&lt; \"fuck\" &lt;&lt; endl;\n#if DEBUG\n    #include \"all.hpp\"\n#else\n    #include &lt;bits/stdc++.h&gt;\n#endif\n\nusing namespace std;\nusing ll = long long;\nusing pii = pair&lt;int,int&gt;;\nusing pll = pair&lt;ll,ll&gt;;\nusing db = long double;\nusing pdd = pair&lt;db, db&gt;;\nusing i128 = __int128_t;\n\nconst ll N = 2000000;\nconst ll INF = 5e18;\nconst ll MOD = 1e9 + 7;\n\nvoid solve() {\n\n    return;\n}\n\nsigned main() {\n#if DEBUG\n    freopen(\"input.txt\", \"r\", stdin);\n    auto start_time = chrono::steady_clock::now();\n#else\n    ios::sync_with_stdio(false);\n#endif\n    cin.tie(nullptr);\n\n    int t = 1;\n    cin &gt;&gt; t;\n\n    while (t--) {\n        solve();\n    }\n\n#if DEBUG\n    auto end_time = chrono::steady_clock::now();\n    auto diff = chrono::duration_cast&lt;chrono::milliseconds&gt;(end_time - start_time);\n    cerr &lt;&lt; \"Time: \" &lt;&lt; diff.count() &lt;&lt; \" ms\" &lt;&lt; endl;\n\n#endif\n\n    return 0;\n}\n</code></pre>"},{"location":"math/numerial/%E6%8B%89%E6%A0%BC%E6%9C%97%E6%97%A5%E6%8F%92%E5%80%BC/","title":"\u62c9\u683c\u6717\u65e5\u63d2\u503c","text":""},{"location":"math/numerial/%E6%8B%89%E6%A0%BC%E6%9C%97%E6%97%A5%E6%8F%92%E5%80%BC/#_1","title":"\u62c9\u683c\u6717\u65e5\u63d2\u503c\u7684\u4ee3\u6570\u5f62\u5f0f","text":"<p>\u5bf9\u4e8e \\(n\\) \u6b21\u591a\u9879\u5f0f \\(f(x)\\), \u53ea\u9700\u8981 \\(n + 1\\) \u4e2a\u4e0d\u540c\u51fd\u6570\u503c\u5c31\u80fd\u786e\u5b9a \\(f(x)\\) \u7684\u5404\u9879\u7cfb\u6570. \u8bbe</p> \\[P(x) = a_0 + a_1 x + a_2 x^2 + \\dots + a_n x^n\\] <p>\u82e5\u5df2\u77e5\u5176\u5728 \\(n+1\\) \u4e2a\u4e92\u4e0d\u76f8\u540c\u70b9\u4e0a\u7684\u53d6\u503c:</p> \\[P(x_i) = y_i \\quad (i = 0,1,\\dots,n)\\] <p>\u5219\u6709\u7ebf\u6027\u65b9\u7a0b\u7ec4:</p> \\[ \\begin{bmatrix} 1 &amp; x_0 &amp; x_0^2 &amp; \\cdots &amp; x_0^n \\\\ 1 &amp; x_1 &amp; x_1^2 &amp; \\cdots &amp; x_1^n \\\\ \\vdots &amp; \\vdots &amp; \\vdots &amp; \\ddots &amp; \\vdots \\\\ 1 &amp; x_n &amp; x_n^2 &amp; \\cdots &amp; x_n^n \\end{bmatrix} \\begin{bmatrix} a_0 \\\\ a_1 \\\\ \\vdots \\\\ a_n \\end{bmatrix} = \\begin{bmatrix} y_0 \\\\ y_1 \\\\ \\vdots \\\\ y_n \\end{bmatrix} \\] <p>\u5de6\u77e9\u9635\u4e3a Vandermonde \u77e9\u9635, \u5176\u884c\u5217\u5f0f:</p> \\[\\prod_{0 \\le i &lt; j \\le n} (x_j - x_i) \\ne 0\\] <p>\u5f53 \\(x_i\\) \u4e92\u5f02\u65f6\u53ef\u9006, \u65b9\u7a0b\u7ec4\u552f\u4e00\u53ef\u89e3, \u56e0\u6b64 \\(n\\) \u6b21\u591a\u9879\u5f0f\u7531 \\(n+1\\) \u4e2a\u70b9\u552f\u4e00\u786e\u5b9a.</p> <p>\u5bf9\u4e8e \\(n\\) \u6b21\u591a\u9879\u5f0f</p> \\[P(x) = a_0 + a_1 x + a_2 x^2 + \\dots + a_n x^n,\\] <p>\u82e5\u5df2\u77e5 \\(P(x_0), P(x_1), \\dots, P(x_n)\\), \u53ef\u6784\u9020:</p> \\[P(x) = \\sum_{i=0}^{n} P(x_i) \\prod_{j \\ne i} \\frac{x - x_j}{x_i - x_j}\\] <p>\u4ee3\u5165 \\((x_i, P(x_i))\\) \u53ef\u9a8c\u8bc1\u6b63\u786e\u6027.</p>"},{"location":"math/numerial/%E6%8B%89%E6%A0%BC%E6%9C%97%E6%97%A5%E6%8F%92%E5%80%BC/#_2","title":"\u5355\u70b9\u62c9\u683c\u6717\u65e5\u63d2\u503c","text":""},{"location":"math/numerial/%E6%8B%89%E6%A0%BC%E6%9C%97%E6%97%A5%E6%8F%92%E5%80%BC/#_3","title":"\u5df2\u77e5\u503c\u53d6\u503c\u8fde\u7eed\u65f6\u7684\u505a\u6cd5","text":"<p>\u82e5 \\(x_0, x_1, \\dots, x_n\\) \u8fde\u7eed\u4e14\u6709\u5e8f, \u53ef\u5199\u4e3a:</p> \\[P(x) = \\sum_{i=0}^{n} (-1)^{n-i} y_i \\frac{pre_{i-1} \\cdot suf_{i+1}}{fac_i \\cdot fac_{n-i}}\\] <p>\u5176\u4e2d:</p> \\[\\begin{align*} pre_i &amp;= \\prod_{j=0}^{i} (x - x_j) \\\\ suf_i &amp;= \\prod_{j=i}^{n} (x - x_j) \\\\ fac_i &amp;= \\prod_{j=1}^{i} j \\end{align*}\\] <p>\u524d\u540e\u7f00\u4f18\u5316\u540e\u53ef \\(O(n \\log n)\\) \u8ba1\u7b97; \u82e5\u4f7f\u7528 \\(O(1)\\) \u9006\u5143\u6280\u5de7\u53ef\u8fdb\u4e00\u6b65\u4f18\u5316\u5230 \\(O(n)\\).</p>"},{"location":"math/numerial/%E6%8B%89%E6%A0%BC%E6%9C%97%E6%97%A5%E6%8F%92%E5%80%BC/#_4","title":"\u5df2\u77e5\u503c\u4e0d\u8fde\u7eed\u65f6\u7684\u505a\u6cd5","text":"<p>\u4e3b\u5305\u53ea\u4f1a\u6734\u7d20\u7684 \\(O(n^2)\\) \u505a\u6cd5, \u4e0d\u8d58\u8ff0.</p>"},{"location":"math/poly/%E6%8C%87%E6%95%B0%E5%9E%8B%E7%94%9F%E6%88%90%E5%87%BD%E6%95%B0/","title":"\u6307\u6570\u578b\u751f\u6210\u51fd\u6570","text":""},{"location":"math/poly/%E6%8C%87%E6%95%B0%E5%9E%8B%E7%94%9F%E6%88%90%E5%87%BD%E6%95%B0/#exp","title":"\u591a\u9879\u5f0f exp","text":"<p>\u6211\u4eec\u4ece\u4e00\u4e2a\u4f8b\u9898\u5165\u624b, \u5f15\u5165\u6307\u6570\u578b\u751f\u6210\u51fd\u6570, \u5e76\u4ecb\u7ecd\u591a\u9879\u5f0f exp \u7684\u6280\u5de7.</p> <p>\u7edf\u8ba1\u6709\u591a\u5c11\u79cd\u957f\u5ea6\u4e3a \\(n\\) \u7684\u6392\u5217 \\(P\\) \u6ee1\u8db3 \\(P_{P_i} \\ne i\\), \u7b54\u6848\u5bf9 \\(998244353\\) \u53d6\u6a21. \u539f\u9898\u94fe\u63a5.</p> <p>\u8003\u8651\u4ece \\(i\\) \u5411 \\(P_i\\) \u8fde\u4e00\u6761\u8fb9, \u6700\u540e\u4f1a\u5f62\u6210\u82e5\u5e72\u7684\u73af, \u5982\u679c\u4e0d\u5b58\u5728\u5927\u5c0f\u4e3a \\(1\\) \u6216\u8005 \\(2\\) \u7684\u73af, \u5c31\u662f\u7b26\u5408\u8981\u6c42\u7684\u6392\u5217. </p> <p>\u4e0d\u59a8\u5148\u8003\u8651\u6bcf\u4e00\u4e2a\u73af\u6709\u591a\u5c11\u79cd\u65b9\u6848, \u8bb0\u4e00\u4e2a\u5927\u5c0f\u4e3a \\(n\\) \u7684\u73af\u6709 \\(g_i\\) \u79cd\u65b9\u6848, \u663e\u7136 \\(g_i = \\frac{i!}{i} = (i - 1)!\\) .</p> <p>\u4e0b\u9762, \u6211\u4eec\u8003\u8651\u8fd9\u4e9b\u73af\u662f\u5982\u4f55\u7ec4\u5408\u5728\u4e00\u8d77\u7684. \u8003\u8651 \\(k\\) \u4e2a\u73af\u62fc\u5728\u4e00\u8d77\u5bf9\u7b54\u6848\u7684\u8d21\u732e, \u8bb0\u7b2c \\(i\\) \u4e2a\u73af\u5927\u5c0f\u4e3a \\(a_i\\), \u8bb0 \\(m = \\sum_{i=1}^{k} a_i\\), \u90a3\u4e48\u8fd9 \\(k\\) \u4e2a\u73af\u5e94\u5f53\u5bf9\u5927\u5c0f\u4e3a \\(m\\) \u7684\u6392\u5217\u4ea7\u751f\u8d21\u732e, \u4e0d\u8003\u8651\u6807\u53f7\u65f6, \u8d21\u732e\u5e94\u5f53\u662f \\(\\prod_{i=1}^{k} g_{a_i}\\), \u8003\u8651\u7ed9\u6bcf\u4e2a\u73af\u5206\u914d\u6807\u53f7, \u4e5f\u5c31\u662f\u4e00\u5806\u7ec4\u5408\u6570\u4e58\u5728\u4e00\u8d77, \u53d1\u73b0\u6700\u540e\u5f88\u591a\u9879\u90fd\u6d88\u6389\u4e86, \u53ea\u5269\u4e0b \\(\\prod_{i=1}^{k} \\frac{1}{a_i!}\\), \u4e8e\u662f\u603b\u7684\u8d21\u732e\u5c31\u662f \\(\\prod_{i=1}^{k} \\frac{g_{a_i}}{a_i!}\\).</p> <p>\u4ece\u591a\u9879\u5f0f\u7684\u89d2\u5ea6\u8003\u8651\u8fd9\u4e2a\u5f0f\u5b50, \u5982\u679c\u5c06\u5176\u53d8\u5f62\u4e3a \\(\\prod_{i=1}^{k} \\frac{g_{a_i} \\cdot x^i}{a_i!}\\), \u5176\u4e2d \\(x\\) \u662f\u81ea\u53d8\u91cf, \u90a3\u4e48\u6700\u7ec8 \\(x\\) \u7684\u5e42\u6b21\u6070\u597d\u5c31\u662f \\(m\\).</p> <p>\u8fd9\u542f\u793a\u6211\u4eec\u5b9a\u4e49 \\(G(x) = \\sum_{i=3}^{\\infty} \\frac{g_i \\cdot x^i}{i!}\\) \u8868\u793a\u5355\u4e2a\u73af\u7684\u8d21\u732e.</p> <p>\u542b\u6709 \\(k\\) \u4e2a\u73af\u7684\u5e8f\u5217\u53ef\u4ee5\u8868\u793a\u4e3a \\(\\frac{{G(x)}^k}{k!}\\) , \u90a3\u4e48\u7b54\u6848\u53ef\u4ee5\u7528\u591a\u9879\u5f0f\u8868\u793a\u4e3a:</p> \\[ \\begin{aligned} F(x) &amp;= 1 + \\sum_{i=1}^{\\infty} \\frac{G(x)^i}{i!} \\\\      &amp;= e^{G(x)} \\end{aligned} \\] <p>\u52a0 \\(1\\) \u662f\u4e3a\u4e86\u51d1\u51fa \\(e^x\\) \u7684\u6cf0\u52d2\u5c55\u5f00\u5f0f. \u4e8e\u662f\u6211\u4eec\u53ef\u4ee5\u7528\u591a\u9879\u5f0fexp\u89e3\u51b3\u6b64\u9898.</p>"},{"location":"math/poly/%E6%8C%87%E6%95%B0%E5%9E%8B%E7%94%9F%E6%88%90%E5%87%BD%E6%95%B0/#ln","title":"\u591a\u9879\u5f0f ln","text":"<p>\u4ee5\u6d1b\u8c37P6295\u4e3a\u4f8b, \u8fd9\u7bc7\u9898\u89e3\u7684\u89e3\u91ca\u5df2\u7ecf\u76f8\u5f53\u8be6\u5c3d\u4e86, \u4e3b\u5305\u4e0d\u518d\u8d58\u8ff0. \u6211\u4eec\u4e3b\u8981\u8ba8\u8bba\u9898\u89e3\u7684\u6700\u540e\u7684\u4e00\u90e8\u5206, \\(F(x)\\) \u600e\u4e48\u5bfc\u51fa\u7b54\u6848.</p> <p>\u8bb0 \\(F'(x) = \\sum_{i=0}^{} \\frac{f_i}{i!} x^i\\) . \u5176\u4e2d \\(f_i\\) \u8868\u793a \\(i\\) \u4e2a\u70b9\u5f62\u6210\u7684\u6709\u6807\u53f7\u5f31\u8054\u901a\u65e0\u6807\u53f7 DAG \u7684\u6570\u91cf. \u90a3\u4e48 \\(f_i / i!\\) \u81ea\u7136\u5c31\u8868\u793a\u65e0\u6807\u53f7\u60c5\u5f62\u4e0b\u7684\u65b9\u6848\u6570, \u5b9a\u4e49 \\(G(x) = \\sum_{i=0}^{}g_i x^i\\) \u8868\u793a\u65e0\u6807\u53f7\u60c5\u51b5\u4e0b, \u5f3a\u8fde\u901a DAG \u7684\u65b9\u6848\u6570, \u90a3\u4e48 \\(F'(x) = e^{G(x)}\\) ,\\(G(x) = ln(F'(x))\\). \u6700\u7ec8\u7b54\u6848\u5c31\u662f \\(g_i \\cdot i!\\) .</p>"},{"location":"travelogue/","title":"\u65c5\u884c\u7684\u610f\u4e49","text":"<p>\u5982\u679c\u4ec0\u4e48\u90fd\u6ca1\u80fd\u7559\u4e0b\u7684\u8bdd, \u5c31\u592a\u53ef\u601c\u4e86.</p> <p>25\u5e74\u4e4b\u524d\u7684\u5185\u5bb9\u90fd\u662f\u56de\u5fc6\u5f55\u4e86, \u8d81\u73b0\u5728\u8fd8\u80fd\u60f3\u8d77\u4e00\u4e9b\u7ec6\u8282, \u5c31\u628a\u5b83\u4eec\u90fd\u8bb0\u4e0b\u6765\u5427.</p>"},{"location":"travelogue/2022/cpho39/","title":"cpho \u590d\u8d5b \u5408\u80a5","text":"<p>\u65e0\u8bba\u597d\u574f, \u7269\u7406\u7ade\u8d5b\u786e\u786e\u5b9e\u5b9e\u7684\u6539\u53d8\u4e86\u6211\u7684\u4e00\u751f, \u6211\u540e\u6765\u505a\u51fa\u7684\u6240\u6709\u9009\u62e9, \u90fd\u80fd\u4ece\u90a3\u4e00\u5e74\u7684\u7269\u7ade\u751f\u6daf\u4e2d\u53d1\u73b0\u4e00\u4e9b\u7aef\u502a.</p>"},{"location":"travelogue/2022/cpho39/#_1","title":"\u8d5b\u524d\u4e00\u5468","text":"<p>\u90a3\u4f1a\u521a\u4e0a\u9ad8\u4e09, \u6211\u4eec\u5b66\u6821\u662f\u53bf\u4e2d, \u6ca1\u6709\u7ade\u8d5b\u751f, \u81ea\u7136\u4e5f\u6ca1\u6709\u7ade\u8d5b\u524d\u505c\u8bfe\u7684\u4e60\u60ef.</p> <p>\u9884\u8d5b\u4e5f\u662f\u8fd9\u6bb5\u65f6\u95f4\u8003\u7684\u5427, \u6211\u8003\u5f97\u5f88\u4e0d\u597d, \u5728\u5b66\u6821\u91cc\u53ea\u6392\u5230\u7b2c\u4e09.</p> <p>\u90a3\u51e0\u5929\u538b\u529b\u975e\u5e38\u5927, \u813e\u6c14\u4e5f\u975e\u5e38\u5dee, \u5e76\u4e14\u5934\u53d1\u6389\u7684\u6781\u5176\u591a, \u51e0\u4e4e\u6478\u4e00\u628a\u5934\u5c31\u8981\u6389\u4e0b\u6765 3, 4 \u6839, \u4e0d\u8fc7\u65f6\u95f4\u8bc1\u660e\u6211\u5e76\u4e0d\u662f\u90a3\u79cd\u5c11\u5e74\u65e9\u79c3\u7684\u4eba, \u5e94\u8be5\u5c31\u662f\u538b\u529b\u5927\u5bfc\u81f4\u7684\u77ed\u65f6\u95f4\u8131\u53d1. \u6211\u8bb0\u5f97 zjw \u95ee\u8fc7\u6211, \"\u4f60\u538b\u529b\u8fd9\u4e48\u5927\u5e72\u561b\", chl \u4f3c\u4e4e\u4e5f\u95ee\u8fc7, \u8fd8\u662f wx \u95ee\u7684? \u6211\u8bb0\u4e0d\u592a\u6e05\u4e86. </p> <p>wyc \u6709\u6b21\u4e0b\u8bfe\u65f6\u95ee\u8fc7\u6211\u9884\u8d5b\u7684\u4e8b, \u4ed6\u542c\u4e86\u6211\u7684\u62b1\u6028\u4e4b\u540e\u5b89\u6170\u6211\u8bf4, \u6211\u5e73\u65f6\u5237\u7684\u662f\u6bd4\u8f83\u96be\u7684\u9898, \u590d\u8d5b\u4e00\u5b9a\u4f1a\u8003\u5f97\u6bd4\u5176\u4ed6\u4eba\u597d\u7684. \u90a3\u662f\u6211\u6536\u5230\u7684\u4e3a\u6570\u4e0d\u591a\u7684\u795d\u798f.</p>"},{"location":"travelogue/2022/cpho39/#_2","title":"\u7406\u8bba\u8003\u8bd5","text":"<p>\u63d0\u524d\u4e00\u5929\u51fa\u53d1\u53bb\u5408\u80a5\u4e86, \u548c\u540c\u5b66\u8001\u5e08\u4e00\u8d77\u505a\u5c0f\u5df4\u8f66\u53bb\u7684, \u597d\u50cf\u4e00\u5171\u4e5d\u4e2a\u4eba.</p> <p>\u665a\u4e0a\u548c zlz \u4f4f\u4e00\u95f4\u623f\u95f4, \u5f88\u70e6\u8e81, \u7761\u4e0d\u7740, \u4e00\u76f4\u5728\u770b\u4e66\u8bb0\u516c\u5f0f, \u76f4\u5230\u51cc\u6668\u4e24\u4e09\u70b9\u624d\u7761\u4e86.</p> <p>\u65e9\u4e0a\u5728\u5bbe\u9986\u5403\u81ea\u52a9, \u5473\u9053\u975e\u5e38\u5dee(\u56de\u53bb\u4e4b\u540e\u4e0a\u5410\u4e0b\u6cfb). \u5403\u5b8c\u5c31\u53bb\u8003\u573a\u4e86.</p> <p>\u62ff\u5230\u5377\u5b50, \u7b2c\u4e00\u9898\u5149\u5b66\u8003\u8fc8\u514b\u5c14\u5b59\u5e72\u6d89\u4eea, \u6ca1\u770b\u61c2, \u6211\u5e76\u4e0d\u64c5\u957f\u5149\u5b66, \u4f46\u662f\u51ed\u7ecf\u9a8c\u8499\u5bf9\u4e86\u7b2c\u4e8c\u95ee.</p> <p>\u7b2c\u4e8c\u9898\u662f\u7535\u78c1, \u6211\u601d\u8003\u4e86\u51e0\u5206\u949f, \u53d1\u73b0\u76f4\u63a5\u5bf9\u80fd\u91cf\u6c42\u5bfc\u5c31\u5f88\u597d\u505a, \u7b97\u4e86\u5f88\u957f, \u611f\u89c9\u4e0d\u592a\u80fd\u5bf9.</p> <p>\u540e\u9762\u597d\u50cf\u6709\u51e0\u9053\u8fde\u5728\u4e00\u8d77\u7684\u529b\u5b66, \u90a3\u5c31\u7b97\u5427, \u7a00\u91cc\u7cca\u6d82\u7684\u7ee7\u7eed\u7b97.</p> <p>\u6700\u540e\u7684\u539f\u5b50\u7269\u7406, \u53ea\u5199\u4e86\u7eaf\u9ad8\u6570\u7684\u79ef\u5206\u90e8\u5206, \u7269\u7406\u7684\u90e8\u5206\u770b\u4e0d\u61c2\u4e86, \u6ca1\u5199.</p> <p>\u8003\u5b8c\u4e4b\u540e, \u6ca1\u4ec0\u4e48\u611f\u60f3, \u611f\u89c9\u4e0d\u597d\u4e5f\u4e0d\u574f, \u4f46\u662f\u6211\u5df2\u7ecf\u628a\u81ea\u5df1\u4f1a\u7684\u90fd\u5199\u4e0a\u53bb\u4e86. \u6536\u5377\u7684\u65f6\u5019, \u6211\u4e0d\u77e5\u9053\u600e\u4e48\u60f3\u7684, \u7a81\u7136\u62ff\u8d77\u7b14\u5728\u8bd5\u9898\u5377\u4e0a\u5199\u4e86\u4e2a\u53c8\u5927\u53c8\u4e11\u7684 \"\u52a0\u6cb9\" , \u6536\u5377\u8001\u5e08\u770b\u5230\u4e4b\u540e, \u6709\u70b9\u6e29\u67d4\u5730\u8bf4\u4e86\u53e5, \u56de\u53bb\u597d\u597d\u4f11\u606f.</p> <p>\u5fc3\u60c5\u5e76\u4e0d\u592a\u574f. </p>"},{"location":"travelogue/2022/cpho39/#_3","title":"\u7406\u8bba\u67e5\u5206","text":"<p>\u4f3c\u4e4e\u662f\u4e00\u4e2a\u5468\u4e94, \u516b\u70b9\u90a3\u4f1a\u6211\u5728\u73ed\u4e0a\u4e0a\u665a\u81ea\u4e60, \u6309\u7406\u8bf4\u8fd9\u4e2a\u70b9\u5206\u6570\u5df2\u7ecf\u51fa\u6765\u4e86, \u4e3a\u4ec0\u4e48\u5988\u5988\u6ca1\u6709\u628a\u5206\u6570\u544a\u8bc9\u73ed\u4e3b\u4efb, \u8ba9\u73ed\u4e3b\u4efb\u8f6c\u544a\u6211\u5462?</p> <p>\u679c\u7136\u8003\u5f97\u5f88\u5dee\u554a, \u53ea\u6709\u516b\u5341\u51e0\u5206\u5417, \u54c8\u54c8, \u867d\u8bf4\u5728\u5b66\u6821\u5185\u662f\u7b2c\u4e00, \u4f46\u662f\u8fd9\u4e2a\u5206\u6570\u663e\u7136\u548c\u7701\u961f\u6ca1\u4ec0\u4e48\u5173\u7cfb\u4e86. \u5f88\u96be\u8fc7.</p> <p>\u6211\u662f\u552f\u4e00\u8fdb\u5b9e\u9a8c\u7684, \u7b2c\u4e8c\u5929\u5c31\u53bb\u5408\u80a5\u53c2\u52a0\u5b9e\u9a8c\u57f9\u8bad\u4e86. \u4e0a\u6b21\u6765\u5408\u80a5\u662f\u4e00\u5927\u8f66\u4eba\u4e00\u8d77\u6765\u7684, \u8fd9\u6b21\u53ea\u6709\u6211\u4e00\u4e2a\u4e86, \u6709\u70b9\u5b64\u5355.</p> <p>\u5b9e\u9a8c\u8003\u5f97\u633a\u7a33\u5b9a\u7684, 43 \u5206, \u548c\u5728\u57f9\u8bad\u57fa\u5730\u6a21\u62df\u8003\u7684\u5206\u6570\u4e00\u6a21\u4e00\u6837.</p> <p>\u6700\u540e\u62ff\u4e86\u7701\u4e00\u5012\u6570\u7b2c\u5341. bad end.</p>"},{"location":"travelogue/2022/cpho39/#after-story","title":"After story","text":"<p>\u540e\u6765\u53d1\u73b0\u6211\u590d\u8d5b\u7535\u5b66\u786e\u5b9e\u7b97\u9519\u4e86, \u6211\u5728\u8ba1\u7b97\u7684\u65f6\u5019\u628a\u5f39\u7c27\u4f38\u957f\u91cf\u548c\u5f39\u7c27\u957f\u5ea6\u5f04\u6df7\u4e86.</p> <p>\u7136\u540e\u529b\u5b66\u9898\u7b97\u9519\u5f88\u591a, \u597d\u5728\u8fc7\u7a0b\u5199\u5f97\u6e05\u6670, \u8fd8\u662f\u62ff\u56de\u4e00\u4e9b\u5206\u6570.</p> <p>\u6211\u4e3a\u8fd9\u6bb5\u7ecf\u5386\u611f\u5230\u5e78\u8fd0\u548c\u81ea\u8c6a.</p>"},{"location":"travelogue/2025/2025icpc%E6%AD%A6%E6%B1%89/","title":"2025 ICPC \u6b66\u6c49","text":""},{"location":"travelogue/2025/2025icpc%E6%AD%A6%E6%B1%89/#day-0","title":"Day 0","text":"<p>\u63d0\u524d\u4e00\u5929\u5230\u6b66\u6c49, \u4ece\u5bbe\u9986\u53bb\u5b66\u6821\u7684\u8def\u4e0a\u5dee\u70b9\u56e0\u4e3a\u95ef\u7eff\u706f\u88ab\u8f66\u521b\u4e86. \u4e0b\u5348\u5728\u6b66\u5927\u901b\u4e86\u4e00\u5708, \u5b66\u6821\u5f88\u6f02\u4eae, \u800c\u4e14\u8d85\u7ea7\u5927. \u665a\u996d\u53bb\u6885\u56ed\u98df\u5802\u5403\u7684, \u70b9\u4e86\u4efd\u70ed\u5e72\u9762\u52a0\u86cb\u9152, \u611f\u89c9\u70ed\u5e72\u9762\u7684\u5473\u9053\u548c\u6211\u5728\u897f\u5b89\u5403\u7684\u5dee\u4e0d\u591a, \u86cb\u9152\u597d\u50cf, \u5c31\u662f\u7cd6\u6253\u86cb\u554a.</p> <p>\u5728\u9152\u5e97 vp \u4e86\u4e00\u628a 2023ICPC\u897f\u5b89, \u6253\u5f97\u4e00\u5768, \u5927\u6a21\u62df\u6b7b\u6d3b\u8c03\u4e0d\u51fa\u6765, \u4f3c\u4e4e\u662f\u5b57\u7b26\u4e32\u8bfb\u53d6\u4e0d\u5f53\u5bfc\u81f4\u4e86\u5947\u602a\u7684 bug . \u4e0d\u8fc7\u505a\u51fa\u6765\u4e00\u4e2a\u94f6\u724c\u9898. \u6700\u540e\u94dc\u4e86.</p> <p>\u6700\u8fd1\u4e24\u573a vp \u7684\u90fd\u5f88\u4e0d\u597d, \u524d\u6bb5\u65f6\u95f4 vp \u51e0\u4e4e\u5168\u90fd\u94f6\u4e86, \u6709\u4e00\u4e24\u628a\u751a\u81f3\u90fd\u91d1\u4e86, \u600e\u4e48\u51e0\u5929\u529f\u592b\u5c31\u53d8\u83dc\u4e86.</p>"},{"location":"travelogue/2025/2025icpc%E6%AD%A6%E6%B1%89/#day-1","title":"Day 1","text":"<p>\u4e0b\u5348\u70ed\u8eab\u8d5b, \u5230\u673a\u4f4d\u7acb\u9a6c\u610f\u8bc6\u5230\u663e\u793a\u5668\u4e0d\u5bf9\u52b2, \u597d\u50cf\u6709\u70b9\u592a\u9ad8\u4e86, \u4f46\u662f\u8c03\u8282\u4e0d\u4e86. \u70ed\u8eab\u8d5b\u6b63\u5f0f\u5f00\u59cb, \u522b\u7684\u961f\u7535\u8111\u90fd\u5f00\u673a\u4e86, \u4f46\u662f\u6211\u4eec\u961f\u7684\u4e0d\u77e5\u9053\u4e3a\u4ec0\u4e48\u8fd8\u662f\u9501\u7740\u7684\u72b6\u6001, \u8ddf\u5de5\u4f5c\u4eba\u5458\u53cd\u9988\u4e4b\u540e\u5927\u6982\u534a\u4e2a\u5c0f\u65f6\u624d\u6709\u4eba\u6765\u5904\u7406, \u5904\u7406\u7684\u65f6\u5019\u4f3c\u4e4e\u53c8\u4e0d\u5c0f\u5fc3\u628a\u522b\u7684\u961f\u7535\u8111\u5173\u4e86...\u4e0d\u8fc7\u6700\u7ec8\u8fd8\u662f\u628a\u6211\u4eec\u7535\u8111\u5f04\u5f00\u4e86. \u5e0c\u671b\u6b63\u8d5b\u4e0d\u8981\u51fa\u8fd9\u79cd\u5e7a\u86fe\u5b50.</p> <p>\u70ed\u8eab\u8d5b\u7b7e\u5230\u662f\u4ec0\u4e48\u4e0d\u8bb0\u5f97\u4e86, \u5370\u8c61\u4e2d\u6709\u4e00\u4e2a\u6784\u9020\u9898, \u548c\u961f\u53cb\u8ba8\u8bba\u8fc7\u7a0b\u4e2d\u60f3\u5230\u4e00\u4e2a\u548c\u4e8c\u8fdb\u5236\u6709\u5173\u7684\u505a\u6cd5, \u4f46\u662f\u961f\u53cb\u4f3c\u4e4e\u8ddf\u6211\u60f3\u7684\u4e0d\u4e00\u6837, \u611f\u89c9\u6709\u70b9\u7ea2\u6e29, \u6b63\u8d5b\u538b\u529b\u786e\u5b9e\u6bd4\u8f83\u5927. \u540e\u9762\u8ddf\u961f\u53cb\u8bf4\u4e86\u6211\u7684\u505a\u6cd5, \u5c31\u8ba9\u6211\u4e0a\u673a\u5199\u4e86. \u4ea4\u4e92\u9898\u611f\u89c9\u9a8c\u8bc1\u6837\u4f8b\u5f88\u9ebb\u70e6, \u5c31\u76f4\u63a5\u4ea4\u4e86, \u7136\u540e wa \u4e00\u53d1, \u68c0\u67e5\u53d1\u73b0\u662f\u4e00\u4e2a\u5f88\u5510\u7684\u9519\u8bef, \u518d\u4ea4\u5c31\u8fc7\u4e86.</p> <p>\u6700\u540e\u4e00\u9898\u6ca1\u505a\u51fa\u6765, \u8d5b\u540e\u53d1\u73b0\u662f\u4e00\u4e2a\u6367\u676f\u9898, \u800c\u4e14\u975e\u5e38 adhoc.</p> <p>\u665a\u4e0a\u53bb\u9ec4\u9e64\u697c\u8f6c\u4e86\u4e00\u5708, \u611f\u89c9\u4e0d\u5982\u5927\u96c1\u5854. \u987a\u9053\u53bb\u957f\u6c5f\u5927\u6865\u770b\u4e86\u4e00\u5708, \u6b66\u6c49\u597d\u50cf, \u786e\u5b9e\u6bd4\u897f\u5b89\u7e41\u534e.</p>"},{"location":"travelogue/2025/2025icpc%E6%AD%A6%E6%B1%89/#day-2","title":"Day 2","text":"<p>\u7535\u8111\u6210\u529f\u89e3\u9501\u4e86.</p> <p>\u6bd4\u8d5b\u5f00\u59cb\u4e4b\u540e\u7f51\u7edc\u762b\u75ea\u4e86\u4e00\u6bb5\u65f6\u95f4, \u770b\u4e0d\u5230\u699c\u4e5f\u4ea4\u4e0d\u4e86\u9898. \u5927\u6982\u534a\u4e2a\u5c0f\u65f6\u624d\u628a\u7b7e\u5230\u4ea4\u4e0a\u53bb. \u6709\u70b9\u6025\u4e86.</p> <p>\u7136\u540e\u770b\u4e86\u4e00\u9053\u94dc\u724c\u9898, \u4e0d\u8bb0\u5f97\u9898\u53f7\u662f\u5565\u4e86, \u6211\u770b\u4e86\u4e00\u4f1a\u641e\u51fa\u6765\u4e00\u4e2a\u5047\u505a\u6cd5, \u5f53\u65f6\u4eba\u6709\u70b9\u6655, \u4e0d\u77e5\u9053\u4e3a\u4ec0\u4e48\u575a\u4fe1\u8fd9\u4e2a\u505a\u6cd5\u662f\u5bf9\u7684, \u5c31\u76f4\u63a5\u5199\u4e86, \u7136\u540e\u9519\u4e86\u4e09\u53d1. \u51b7\u9759\u4e0b\u6765\u4e4b\u540e\u548c\u961f\u53cb\u91cd\u65b0\u8ba8\u8bba, \u53d1\u73b0\u4e00\u4e2a\u5f88\u5f3a\u7684\u6027\u8d28, \u7136\u540e\u961f\u53cb\u4e0a\u53bb\u8fc7\u4e86\u8fd9\u4e2a\u9898.</p> <p>M \u662f\u795e\u79d8\u6784\u9020, \u505a\u4e0d\u51fa\u6765, \u505a\u4e0d\u51fa\u6765, \u4e00\u76f4\u505a\u4e0d\u51fa\u6765, \u8d8a\u505a\u8d8a\u6025, \u8d8a\u505a\u4e0d\u51fa\u6765, \u4fe1\u5fc3\u6d88\u78e8\u6b86\u5c3d, \u8fd9\u65f6\u5019\u6211\u4f3c\u4e4e\u5df2\u7ecf\u770b\u89c1\u94c1\u724c\u7684\u7ed3\u5c40\u4e86, \u751a\u81f3\u8111\u5b50\u91cc\u4f1a\u7a81\u7136\u5192\u51fa \u201c\u5982\u679c\u6ca1\u9009\u8fd9\u7ad9\u5c31\u597d\u4e86\u201d \u7684\u60f3\u6cd5, \u611f\u89c9\u5fc3\u601d\u5df2\u7ecf\u4e0d\u5728\u6bd4\u8d5b\u4e0a\u4e86, \u51b7\u9759\u4e0d\u4e0b\u6765, \u5f88\u7edd\u671b.</p> <p>\u6211\u51b3\u5b9a\u53bb\u770b H, \u8ddf\u6784\u9020\u6b7b\u78d5\u662f\u5f88\u5371\u9669\u7684\u884c\u4e3a, \u800c\u4e14\u6211\u5f88\u6e05\u695a\u6211\u4eec\u961f\u6709\u94f6\u724c\u6c34\u5e73, \u5c31\u7b97\u505a\u4e0d\u51fa\u8fd9\u4e2a\u9898\u4e5f\u80fd\u505a\u51fa\u522b\u7684. \u6211\u9a6c\u4e0a\u60f3\u5230\u4e00\u4e2a\u770b\u4e0a\u53bb\u5f88\u5bf9\u7684\u505a\u6cd5, \u8ddf\u961f\u53cb\u8bf4\u4e86\u4e00\u4e0b\u4ed6\u4e5f\u89c9\u5f97\u5f88\u5bf9, \u4e8e\u662f\u6211\u6ca1\u7ec6\u60f3\u5c31\u4e0a\u673a\u5199\u4e86, \u5199\u5b8c\u4e4b\u540e\u4ea4\u4e0a\u53bb wa, \u5199\u4e86\u5bf9\u62cd\u624d\u53d1\u73b0\u6709\u4e00\u79cd\u7279\u6b8a\u60c5\u51b5\u6ca1\u8003\u8651, \u5176\u5b9e\u4e5f\u4e0d\u90a3\u4e48\u7279\u6b8a, \u6211\u4e0d\u61c2\u4e3a\u4ec0\u4e48\u6211\u6ca1\u6ce8\u610f\u5230, \u5f7b\u5e95\u6655\u4e86.</p> <p>\u4e09\u5c0f\u65f6\u65f6\u961f\u53cb\u505a\u51fa\u4e86 K, \u611f\u89c9\u6709\u5e0c\u671b\u4e86, \u8fd8\u6709\u673a\u4f1a.</p> <p>\u5feb\u5230\u56db\u5c0f\u65f6\u65f6\u961f\u53cb\u731c\u51fa\u4e86 M \u7684\u505a\u6cd5, \u770b\u6765\u4e0d\u53ef\u80fd\u6253\u94c1\u4e86, \u53ea\u8981\u518d\u51fa\u4e00\u9898, \u5c31\u80fd\u94f6. \u53ef\u662f\u6211\u4ecd\u5728\u4e0e H \u7ea0\u7f20, \u4e00\u76f4\u8bd5\u56fe\u633d\u6551\u90a3\u4e2a\u5047\u505a\u6cd5, \u5176\u5b9e\u90a3\u4e2a\u505a\u6cd5\u9762\u5bf9\u7684\u95ee\u9898, \u663e\u7136\u662f\u65e0\u6cd5\u514b\u670d\u7684, \u4f46\u662f\u8d5b\u65f6\u5b8c\u5168\u6655\u4e86, \u5df2\u7ecf\u5931\u53bb\u4e86\u6700\u57fa\u672c\u7684\u5224\u65ad\u80fd\u529b, \u7136\u540e\u5c31\u4e00\u76f4\u5728\u6d6a\u8d39\u65f6\u95f4. \u6700\u540e\u4e00\u4e2a\u5c0f\u65f6, \u961f\u53cb\u5728\u770b C, \u4e5f\u662f\u6784\u9020\u9898, \u5c01\u68d2\u524d\u6700\u540e\u4e00\u4e2a\u5c0f\u65f6, C \u8fc7\u4e86\u5f88\u591a\u961f\u4f0d, \u4f30\u8ba1\u662f\u6b6a\u699c\u4e86.</p> <p>\u961f\u53cb C \u4f3c\u4e4e\u60f3\u5f97\u5dee\u4e0d\u591a\u4e86, \u4ed6\u4eec\u4e0a\u673a\u5199 C \u7684\u65f6\u5019\u53ea\u5269\u6700\u540e\u534a\u4e2a\u5c0f\u65f6, \u6211\u77e5\u9053 H \u4e0d\u53ef\u80fd\u901a\u8fc7\u4e86, \u5c31\u7b97\u77e5\u9053\u505a\u6cd5, \u4e5f\u6ca1\u65f6\u95f4\u5199. \u6700\u540e\u534a\u4e2a\u5c0f\u65f6\u6211\u4ec0\u4e48\u90fd\u6ca1\u5e72, \u5bf9\u6211\u6765\u8bf4\u6bd4\u8d5b\u53ef\u80fd\u65e9\u5c31\u7ed3\u675f\u4e86.</p> <p>\u961f\u53cb\u6700\u7ec8\u6ca1\u6709\u5199\u51fa C, \u5c11\u8003\u8651\u51e0\u4e2a\u60c5\u51b5. \u5982\u679c\u6211\u548c\u4ed6\u4eec\u4e00\u8d77\u770b\u8fd9\u9898, \u7ed3\u5c40\u53ef\u80fd\u5c31\u4e0d\u4e00\u6837\u4e86\u5427.</p> <p>\u94dc\u4e86. \u5669\u68a6\u91cc\u7684\u5185\u5bb9, \u597d\u50cf\u662f\u6211\u4e00\u624b\u9020\u5c31\u7684.</p> <p>\u665a\u4e0a\u5728\u9152\u5e97\u8eba\u7740, \u6ca1\u4ec0\u4e48\u60f3\u505a\u7684\u4e8b\u60c5, \u7b2c\u4e8c\u5929\u7684\u65c5\u6e38\u8ba1\u5212\u4e5f\u53d6\u6d88\u4e86, \u6539\u7b7e\u4e86\u66f4\u65e9\u7684\u9ad8\u94c1, \u53ea\u60f3\u5c3d\u5feb\u9003\u79bb\u8fd9\u4e2a\u57ce\u5e02.</p>"},{"location":"travelogue/2025/2025icpc%E6%AD%A6%E6%B1%89/#after-story","title":"After story","text":"<p>\u4e4b\u540e\u4e24\u5929\u7684\u65f6\u95f4\u5fc3\u60c5\u5f88\u538b\u6291. \u6211\u6709\u70b9\u6000\u7591\u81ea\u5df1\u662f\u4e0d\u662f\u56e0\u4e3a\u67d0\u4e9b\u975e\u667a\u529b\u56e0\u7d20, \u4e0d\u9002\u5408\u6253\u7ade\u8d5b, \u56e0\u4e3a\u6211\u6b63\u8d5b\u597d\u50cf\u5c31\u6ca1\u53d1\u6325\u597d\u8fc7, \u9ad8\u4e2d\u5982\u6b64, \u5927\u5b66\u8fd8\u662f\u8fd9\u6837.</p> <p>M \u770b\u4e0d\u51fa\u6765\u771f\u7684\u5f88\u79bb\u8c31, \u8fd9\u79cd\u7a0b\u5ea6\u7684\u5bf9\u79f0\u6027\u6211\u6ca1\u9053\u7406\u6ce8\u610f\u4e0d\u5230\u7684.</p> <p>H \u4e5f\u5f88\u79bb\u8c31, \u60f3\u4e86\u8fd9\u4e48\u957f\u65f6\u95f4\u7adf\u7136\u5b8c\u5168\u6ca1\u6709\u8003\u8651\u8fc7\u5b57\u5178\u6811.</p> <p>A \u5176\u5b9e\u4e5f\u662f\u5f88\u53ef\u505a\u7684\u9898, \u662f\u4e00\u4e2a\u7c7b\u6b27\u6c42\u548c\u7684\u9898.</p> <p>C \u4e5f\u5f88\u53ef\u60dc, \u6211\u610f\u5916\u7684\u5f88\u64c5\u957f\u8fd9\u79cd\u6784\u9020. \u4f46\u662f\u8d5b\u65f6\u5b8c\u5168\u6ca1\u53c2\u4e0e.</p> <p>\u4f46\u662f\u8bf4\u4ec0\u4e48\u90fd\u6ca1\u7528\u4e86, \u6b63\u8d5b\u4ec0\u4e48\u90fd\u6ca1\u505a\u51fa\u6765, \u7ed3\u679c\u5c31\u662f\u5982\u6b64.</p> <p>\u8d5b\u540e\u5f88\u591a\u4eba\u55b7\u8fd9\u573a\u9898\u76ee\u8d28\u91cf\u4e0d\u884c, \u4e8b\u5b9e\u597d\u50cf\u786e\u5b9e\u662f\u8fd9\u6837, \u6784\u9020\u9898\u8fc7\u591a\u5bfc\u81f4\u5f88\u591a\u961f\u4f0d\u6ca1\u6709\u53d1\u6325\u51fa\u6b63\u5e38\u6c34\u5e73, \u54c8\u5de5\u5927\u4e00\u961f\u90fd\u94dc\u4e86, \u5f88\u79bb\u8c31. \u4f46\u662f\u663e\u7136\u4e0d\u80fd\u628a\u8d23\u4efb\u5f52\u7ed3\u5230\u9898\u76ee\u4e0a, \u66f4\u591a\u7684\u539f\u56e0\u5728\u4e8e\u81ea\u8eab.</p>"},{"location":"travelogue/2025/2025icpc%E6%B2%88%E9%98%B3/","title":"2025 ICPC \u6c88\u9633","text":""},{"location":"travelogue/2025/2025icpc%E6%B2%88%E9%98%B3/#day-1","title":"Day -1","text":"<p>\u4e34\u8d70\u524d\u6700\u540e vp \u4e00\u628a, 2025 CCPC \u54c8\u5c14\u6ee8, \u505a\u51fa\u4e86\u94f6\u724c\u7684\u53d8\u79cd manacher, \u4f46\u662f\u6ca1\u505a\u51fa\u94dc\u724c\u795e\u79d8\u6784\u9020, \u9057\u61be\u94dc\u9996\u4e86...</p>"},{"location":"travelogue/2025/2025icpc%E6%B2%88%E9%98%B3/#day-0","title":"Day 0","text":"<p>\u961f\u53cb\u4e2d\u5348\u5750\u98de\u673a\u5148\u53bb\u6c88\u9633\u4e86, \u6211\u56e0\u4e3a\u4e0b\u5348\u6709\u5b9e\u9a8c\u8bfe\u6240\u4ee5\u8ba2\u4e86\u665a\u4e0a\u7684\u98de\u673a. \u5230\u4e86\u4e0b\u5348, \u7a81\u7136\u4e0d\u662f\u5f88\u60f3\u53bb\u4e0a\u8bfe, \u800c\u4e14\u884c\u674e\u4e5f\u6ca1\u6574\u7406\u597d...\u7b97\u4e86\u8fd8\u662f\u7fd8\u6389\u5427, \u53cd\u6b63\u6709\u5047\u6761.</p>"},{"location":"travelogue/2025/2025icpc%E6%B2%88%E9%98%B3/#day-1_1","title":"Day 1","text":"<p>\u65e9\u4e0a\u7761\u5230 10 \u70b9\u624d\u8d77\u6765, \u6d17\u6f31\u4e00\u4e0b\u9a6c\u4e0a\u5c31\u53bb\u4e1c\u5317\u5927\u5b66\u7b7e\u5230\u4e86, \u5f88\u79bb\u5947\u7684\u662f\u6ca1\u6709\u62cd\u7167\u73af\u8282, \u5e76\u4e14\u53d1\u73b0\u4f53\u80b2\u573a\u91cc\u5728\u529e\u8fbd\u5b81\u7701\u8d5b, \u7701\u8d5b\u7adf\u7136\u80fd\u7528\u533a\u57df\u8d5b\u7684\u573a\u5730, \u592a\u8c6a\u534e. \u5728\u975e\u51f8\u7684\u644a\u4f4d\u73a9\u4e86\u6295\u58f6, \u7206\u96f6\u4e86!!! \u5348\u996d\u5728\u5b66\u6821\u98df\u5802\u89e3\u51b3\u4e86, \u5403\u5b8c\u4e4b\u540e\u7259\u6709\u70b9\u75bc, \u4e0d\u77e5\u9053\u662f\u4e0d\u662f\u9aa8\u5934\u6e23\u523a\u8fdb\u7259\u5e8a\u4e86?</p> <p>\u4e0b\u5348\u5728\u5b66\u6821\u901b\u4e86\u4f1a, \u7136\u540e\u53bb\u542c\u534e\u4e3a\u7684\u8bb2\u5ea7, \u8bf4\u5b9e\u8bdd\u542c\u4e0d\u592a\u61c2, \u5b8c\u4e8b\u4e4b\u540e\u53bb\u5403\u8457\u540d\u7684\u4e1c\u5317\u94c1\u9505\u7096, \u5473\u9053\u786e\u5b9e\u8fd8\u4e0d\u9519! \u4e1c\u5317\u5929\u9ed1\u5f97\u597d\u65e9\u554a, \u4e94\u70b9\u5c31\u9ed1\u900f\u4e86.</p> <p>\u5403\u5b8c\u996d\u8d76\u7d27\u8dd1\u53bb\u53c2\u52a0\u70ed\u8eab\u8d5b, \u8fdf\u5230\u4e86\u534a\u4e2a\u5c0f\u65f6, \u7136\u540e\u88ab A \u9898\u7684\u6784\u9020\u901a\u4fe1\u9898\u5355\u9632\u4e00\u4e2a\u534a\u5c0f\u65f6, \u961f\u53cb\u573a\u5207\u4e86\u4e09\u4e2a\u9898, \u5e76\u4e14\u8d5b\u540e\u79d2\u6740\u4e86 A , emmm , \u8bf4\u5b9e\u8bdd\u8fd9\u4e2a A \u786e\u5b9e\u4e0d\u96be, \u4f46\u6211\u4e0d\u77e5\u9053\u4e3a\u4ec0\u4e48\u6211\u6ca1\u60f3\u5230.</p> <p>\u72b6\u6001\u6709\u70b9\u5dee, \u5e0c\u671b\u660e\u5929\u4e0d\u8981\u72af\u75c5.</p>"},{"location":"travelogue/2025/2025icpc%E6%B2%88%E9%98%B3/#day-2","title":"Day 2","text":"<p>\u8d70\u5230\u5b66\u6821\u95e8\u53e3\u65f6\u5929\u4e0a\u4e0b\u8d77\u4e86\u5c0f\u96ea.</p> <p>\u5192\u7740\u5bd2\u98ce\u62b5\u8fbe\u8d5b\u573a, \u611f\u89c9\u5fc3\u8df3\u5f97\u5f88\u5feb, \u7a00\u91cc\u7cca\u6d82\u7684\u542c\u5b8c\u4e86\u5f00\u5e55\u5f0f.</p> <p>\u6bd4\u8d5b\u5f00\u59cb, \u5f88\u5feb\u53d1\u73b0 I \u662f\u4e00\u4e2a\u975e\u5e38\u7b7e\u5230\u7684\u6a21\u62df\u9898, \u4e00\u53d1 AC. \u7136\u540e\u548c\u961f\u53cb\u4e00\u8d77\u770b B , \u6211\u770b\u4e86\u4e00\u773c\u6ca1\u4ec0\u4e48\u601d\u8def, \u5c31\u53bb\u770b M \u4e86, \u53d1\u73b0 M \u662f\u5927\u6a21\u62df, \u7acb\u9a6c\u4e0a\u673a\u5f00\u59cb\u5199, \u5199\u4e86\u81f3\u5c11 20 \u5206\u949f, \u7136\u540e\u53d1\u73b0\u8fc7\u4e0d\u4e86\u6837\u4f8b, \u8fd9\u65f6\u5df2\u7ecf\u6709\u70b9\u7ea2\u6e29\u4e86, \u597d\u5728\u4e00\u4e2a\u5c0f\u65f6\u7684\u65f6\u5019\u961f\u53cb\u987a\u5229\u8fc7\u4e86 B , \u611f\u89c9\u538b\u529b\u5c0f\u4e86\u4e9b, \u5f88\u5feb\u961f\u53cb\u53d1\u73b0\u6211\u662f\u628a M \u8f93\u5165\u5199\u9519\u4e86, \u6211\u7684\u5929\u5450\u6211\u600e\u4e48\u4f1a\u72af\u8fd9\u4e48\u4f4e\u7ea7\u7684\u9519\u8bef...\u57cb\u4e0b\u4f0f\u7b14\u4e86. \u6700\u7ec8\u4e00\u4e2a\u534a\u5c0f\u65f6\u624d\u8fc7 M .</p> <p>\u6b64\u65f6\u5df2\u7ecf\u6ca1\u4ec0\u4e48\u80fd\u5f00\u7684\u9898\u4e86, \u53ea\u6709 K \u8fc7\u5f97\u6bd4\u8f83\u591a, \u4f46\u662f\u6211\u4eec\u4e09\u4e2a\u90fd\u6ca1\u4ec0\u4e48\u601d\u8def, \u601d\u8003\u4e86\u4e00\u6bb5\u65f6\u95f4\u540e, \u6211\u51b3\u5b9a\u4e0d\u518d\u6d6a\u8d39\u65f6\u95f4, \u53bb\u5f00\u5176\u4ed6\u9898. G \u662f\u8ba1\u7b97\u51e0\u4f55\u554a, \u800c\u4e14\u548c\u79ef\u5206\u6709\u5173, \u770b\u4e0a\u53bb\u5f88\u5413\u4eba, but \u6211\u662f\u9ad8\u6570\u5927\u5e08, \u4e0d\u4f1a\u88ab\u4e8c\u91cd\u79ef\u5206\u5413\u8dd1. \u770b\u4e86\u4e00\u4f1a\u4e4b\u540e\u611f\u89c9\u8fd9\u9898\u5f88\u7269\u7406, \u5bf9\u79f0\u7684\u770b, \u7b54\u6848\u663e\u7136\u662f\u4e00\u4e2a\u5206\u5f0f, \u5206\u5b50\u5e94\u5f53\u662f \\(S_P * S_Q\\), \u5206\u6bcd\u663e\u7136\u662f P \u4e0a\u67d0\u70b9\u7ed5 Q \u5f62\u6210\u7684\u8f68\u8ff9\u7684\u9762\u79ef, \u53ea\u7528\u518d\u505a\u4e00\u6b21\u51f8\u5305\u5c31\u53ef\u4ee5\u4e86. \u8fd9\u4e48\u7b80\u5355\u7684\u9898\u4e3a\u4ec0\u4e48\u53ea\u6709\u4e24\u4e2a\u4eba\u8fc7\u5462?? \u6211\u76f4\u63a5\u4e0a\u673a\u5f00\u59cb\u5199, \u6572\u4e86\u4e8c\u5341\u591a\u5206\u949f\u624d\u6572\u5b8c\u51f8\u5305\u6a21\u7248, \u6700\u7ec8\u5728 3 \u5c0f\u65f6\u65f6\u901a\u8fc7\u4e86 G , \u6211\u4eec\u6392\u540d\u4e0a\u5347\u5230 80 , \u5df2\u7ecf\u770b\u89c1\u80dc\u5229\u7684\u66d9\u5149\u4e86. </p> <p>\u6211\u53bb\u4e0a\u4e86\u4e2a\u5395\u6240, \u770b\u89c1\u5916\u9762\u96ea\u4e0b\u5f97\u5f88\u5927.</p> <p>\u534a\u5c0f\u65f6\u4e4b\u540e\u961f\u53cb\u89c2\u5bdf\u51fa\u4e86 K \u7684\u505a\u6cd5, \u6211\u89c9\u5f97\u5f88\u5bf9, \u4e0a\u673a\u6572\u5b8c, \u4e00\u53d1 AC, \u6392\u540d\u4e0a\u5347\u5230 26, \u91d1\u724c\u5e76\u975e\u9065\u4e0d\u53ef\u53ca.</p> <p>\u6700\u540e\u534a\u5c0f\u65f6\u51b3\u5b9a all in F, \u6211\u4e0a\u673a\u5199\u51fa\u6765\u4e00\u4e2a\u5c4e\u5c71\u4ee3\u7801, \u6700\u540e\u4e8c\u5341\u5206\u949f\u4e00\u76f4\u5728\u627e hack \u8c03\u4ee3\u7801, \u6700\u7ec8\u4e5f\u6ca1\u505a\u51fa\u6765, \u53ef\u60dc\u4e86, \u8fd8\u662f\u6ca1\u80fd\u6446\u8131\u5c01\u699c\u4ee5\u540e\u65e0\u6cd5\u8fc7\u9898\u7684\u8bc5\u5492.</p> <p>\u6700\u7ec8 rank 43 \u9057\u61be\u94f6\u724c\u7b2c\u4e09, \u6bd4\u91d1\u5c3e\u5dee\u4e86\u4e8c\u5341\u5206\u949f\u7f5a\u65f6, \u4e0d\u8fc7\u4e5f\u5f88\u4e0d\u9519\u4e86, \u8fd9\u4e2a\u53d1\u6325\u5df2\u7ecf\u8d85\u51fa\u9884\u671f. \u867d\u7136\u6ca1\u80fd\u593a\u91d1, \u4f46\u662f\u597d\u50cf\u80fd\u53bb ec-final \u4e86?</p> <p>\u8d70\u51fa\u8d5b\u573a, \u53d1\u73b0\u5916\u9762\u662f\u5929\u5df2\u7ecf\u6674\u4e86, \u4f46\u662f\u72c2\u98ce\u4f9d\u65e7, \u628a\u6211\u4eec\u961f\u540d\u724c\u4e0a\u7684\u6c14\u7403\u8fde\u6839\u62d4\u8d77.</p>"},{"location":"travelogue/2025/2025icpc%E6%B2%88%E9%98%B3/#after-story","title":"After Story","text":"<p>\u540e\u6765\u53d1\u73b0, F \u6ca1\u505a\u51fa\u6765\u4e0d\u662f\u56e0\u4e3a\u6211\u4ee3\u7801\u5199\u6302\u4e86, \u800c\u662f\u56e0\u4e3a\u6709\u4e00\u4e2a\u7279\u6b8a\u60c5\u51b5\u6ca1\u8003\u8651\u5230, \u800c\u4e14\u8fd9\u4e2a\u60c5\u51b5\u4e0d\u7528 bfs \u627e\u73af\u6781\u96be\u5904\u7406.</p> <p>\u7136\u540e, A \u5176\u5b9e\u662f\u66f4\u53ef\u505a\u7684\u9898, \u8d5b\u65f6\u57fa\u672c\u6ca1\u5728\u8fd9\u4e2a\u9898\u4e0a\u82b1\u592a\u591a\u65f6\u95f4, \u76f4\u63a5\u8df3\u8fc7\u4e86. \u4e3a\u4ec0\u4e48\u4e0d\u80fd\u66f4\u4fe1\u4efb\u4e00\u70b9\u81ea\u5df1\u7684\u6570\u5b66\u80fd\u529b\u5462.</p> <p>\u8fd9\u573a\u6bd4\u8d5b\u5931\u8bef\u8fd8\u662f\u5f88\u591a\u7684, \u4e0d\u8fc7\u4e00\u5207\u5931\u8bef\u7684\u6839\u6e90\u90fd\u662f\u83dc, \u65e0\u987b\u591a\u8a00, \u7ee7\u7eed\u52a0\u7ec3, \u660e\u5e74, \u4e00\u5b9a\u4f1a\u8d62\u7684.</p> <p>\u7259\u597d\u50cf\u4e0d\u75bc\u4e86.</p>"}]}